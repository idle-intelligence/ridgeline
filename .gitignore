# Rust
/core/target
**/*.rs.bk

# wasm-pack output (built artifact, regenerated)
/core/pkg
/web/pkg

# JS dev deps
/web/node_modules
/web/package-lock.json

# Python
__pycache__/
*.pyc
.venv/
venv/

