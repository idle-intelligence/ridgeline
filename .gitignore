/data/bake/cache/
/data/srtm-cache/

# Agent-dashboard worktree metadata
/.claude/

# OS
.DS_Store

# Internal working notes (AI session handoffs, plans) — not part of the public repo
/docs/HANDOFF.md
/docs/overnight-plan.md

# Terrain blobs — hosted on the HF dataset idle-intelligence/ridgeline-terrain, not in git
/data/*.bin

# large preview images live on the HF dataset, not in git
data/*preview*.png
